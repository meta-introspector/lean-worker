/-- Verify all contexts are valid. -/
def verifyContexts : Bool :=
  generateContexts.all (fun ctx =>
    ctx.name.length > 0 ∧
    ctx.maxTokens > 0 ∧
    ctx.timeout.getD 0 ≥ 0)

/-- Run agent-c workflow. -/
def main : IO Unit := do
  let contexts := generateContexts
  let valid := verifyContexts
  if valid then
    IO.println "✅ All plugin contexts verified"
    for ctx in contexts do
      IO.println s!"  {ctx.name}: {ctx.resourceKind}://{ctx.resourceName}"
  else
    IO.println "❌ Some plugin contexts failed verification"

  IO.println s!"  Total: {contexts.length} contexts, {contexts.length - 45} unused"
  IO.println "agent-c complete"

end AgentC