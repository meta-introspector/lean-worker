namespace NiemeierA8

/-- Rank of a single A_8 root lattice. -/
def rank_A8 : Nat := 8

/-- Coxeter number of A_8: h = rank + 1 = 9. -/
def coxeter_A8 : Nat := rank_A8 + 1

theorem coxeter_A8_eq_nine : coxeter_A8 = 9 := rfl

/-- Root count of A_8: |Phi(A_8)| = 8 * 9 = 72 roots of squared length 2. -/
def num_roots_A8 : Nat := rank_A8 * coxeter_A8

theorem num_roots_A8_eq_72 : num_roots_A8 = 72 := rfl

/-- Total rank of Niemeier lattice N(A_8^3): 3 * 8 = 24. -/
def rank_niemeier : Nat := 3 * rank_A8

theorem rank_niemeier_eq_24 : rank_niemeier = 24 := rfl

/-- Total root count in direct sum A_8^3: 3 * 72 = 216 roots. -/
def num_roots_niemeier : Nat := 3 * num_roots_A8

theorem num_roots_niemeier_eq_216 : num_roots_niemeier = 216 := rfl

/-- Determinant of A_8 Cartan matrix: det(A_8) = 8 + 1 = 9. -/
def det_A8 : Nat := rank_A8 + 1

theorem det_A8_eq_nine : det_A8 = 9 := rfl

/-- Determinant of direct sum root sublattice A_8^3: det(A_8)^3 = 9^3 = 729. -/
def det_root_sublattice : Nat := det_A8 ^ 3

theorem det_root_sublattice_eq_729 : det_root_sublattice = 729 := rfl

/-- Inverse Cartan quadratic form of A_8 on fundamental weights, scaled by det(A_8) = 9:
    9 * ⟨ω_i, ω_i⟩ = (i % 9) * (9 - (i % 9)). -/
def a8_weight_norm_scaled (i : Nat) : Nat :=
  let c := i % 9
  c * (9 - c)

/-- Scaled quadratic form on discriminant group (A_8* / A_8)^3 ≅ (Z/9Z)^3. -/
def glue_vec_norm_scaled (c1 c2 c3 : Nat) : Nat :=
  a8_weight_norm_scaled c1 + a8_weight_norm_scaled c2 + a8_weight_norm_scaled c3

/-- A glue vector in (A_8* / A_8)^3 yields an even lattice vector iff its 9-scaled norm is divisible by 18. -/
def is_even_integral_glue (c1 c2 c3 : Nat) : Bool :=
  (glue_vec_norm_scaled c1 c2 c3) % 18 == 0

/-- Explicit 27-element isotropic glue code G_glue ⊂ (Z/9Z)^3
    generated by g_1 = (1, 1, 4) and g_2 - g_1 = (3, 0, 6). -/
def glue_code : List (Nat × Nat × Nat) :=
  (List.range 9).foldr (fun a acc =>
    (List.range 3).foldr (fun b inner =>
      ((a + 3 * b) % 9, a % 9, (4 * a + 6 * b) % 9) :: inner
    ) acc
  ) []

/-- Order of the glue code group: |G_glue| = 27. -/
def glue_group_order : Nat := glue_code.length

theorem glue_order_sq_eq_det : glue_group_order ^ 2 = det_root_sublattice := by
  unfold glue_group_order glue_code det_root_sublattice det_A8 rank_A8
  decide

/-- Every element of the 27-element glue code G_glue is even-integral. -/
theorem glue_code_all_even_integral :
    glue_code.all (fun v => is_even_integral_glue v.1 v.2.1 v.2.2) = true := by
  unfold glue_code is_even_integral_glue glue_vec_norm_scaled a8_weight_norm_scaled
  decide

/-- Unimodularity of the Niemeier lattice: det(N) = det(A_8^3) / |G_glue|^2 = 1 and all glue codewords are even-integral. -/
def det_niemeier : Nat := det_root_sublattice / (glue_group_order ^ 2)

theorem det_niemeier_unimodular :
    det_niemeier = 1 ∧
    glue_code.all (fun v => is_even_integral_glue v.1 v.2.1 v.2.2) = true := by
  unfold det_niemeier glue_group_order glue_code det_root_sublattice det_A8 rank_A8
  unfold is_even_integral_glue glue_vec_norm_scaled a8_weight_norm_scaled
  decide

/-- Glue generator g = (1, 1, 4) has squared norm 4 (even integer). -/
theorem glue_gen_is_even_integer :
    glue_vec_norm_scaled 1 1 4 / 9 = 4 ∧
    is_even_integral_glue 1 1 4 = true := by
  unfold glue_vec_norm_scaled a8_weight_norm_scaled is_even_integral_glue
  decide

/-- Euler characteristic of K3 surface: chi(K3) = 1 - 0 + 22 - 0 + 1 = 24. -/
def chi_K3 (b0 b1 b2 b3 b4 : Nat) : Int :=
  (b0 : Int) - (b1 : Int) + (b2 : Int) - (b3 : Int) + (b4 : Int)

theorem chi_K3_equals_niemeier_rank : chi_K3 1 0 22 0 1 = (rank_niemeier : Int) := rfl

/-- Umbral lambency l = h(A_8) = 9 for the A_8^3 Niemeier moonshine. -/
def lambency_A8_cubed : Nat := coxeter_A8

theorem lambency_eq_nine : lambency_A8_cubed = 9 := rfl

