[Unit]
Description=OTC Proof Trading Desk — relay + GUI
Documentation=https://github.com/meta-introspector/kant-zk-pastebin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=otc-desk
Group=otc-desk
StateDirectory=otc-desk
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M
ReadOnlyPaths=/mnt/data1/time-2026/09-september/18/lean-worker
ReadOnlyPaths=/mnt/data1/aristotle-builds
InaccessiblePaths=/home/mdupont/.ssh
SystemCallFilter=@system-service
SystemCallArchitectures=native
WorkingDirectory=/mnt/data1/time-2026/09-september/18/lean-worker/minimal/DeskServer
ExecStart=/usr/bin/node /mnt/data1/time-2026/09-september/18/lean-worker/minimal/DeskServer/desk-relay.mjs --port 8787 --host 127.0.0.1 --static /mnt/data1/time-2026/09-september/18/lean-worker/minimal/DeskServer/web --log /var/lib/otc-desk/relay.log
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target