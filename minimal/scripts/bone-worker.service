[Unit]
Description=bone proof worker (gokujo launchpad mesh)
Documentation=file:///home/mdupont/projects/lean-worker/minimal/docs/SESSION_2026-09-28_CUT_BONES.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mdupont
Group=mdupont
# Offers come from emit-offers.mjs; results and the claim ledger land here.
Environment=BONES_ROOT=/mnt/data1/aristotle-merge/bones
Environment=STATE_DIR=/var/lib/bone-worker
Environment=POLL_SECONDS=30
Environment=JOB_TIMEOUT_SECONDS=3600
# Mesh gossip (tracker lib/control.mjs /control/sync): local tracker dev
# peer on 3318; token must match its CONTROL_TOKEN (.dev.vars / worker secret)
Environment=CONTROL_PEERS=http://127.0.0.1:3318
Environment=CONTROL_TOKEN=scp-mesh-dev-token
# node lives in the user's nix profile, not /usr/bin (status 203/EXEC otherwise)
ExecStart=/home/mdupont/.nix-profile/bin/node /home/mdupont/projects/lean-worker/minimal/scripts/bone-worker.mjs
# lean/lake/elan live in the user's elan + nix profiles; without this the
# knife's build stage dies with "no toolchain available" on every job
Environment=PATH=/home/mdupont/.elan/bin:/home/mdupont/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=always
RestartSec=10
# The state ledger makes restarts safe: claims are written before work starts,
# results after. A killed worker re-claims at most its in-flight job.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
